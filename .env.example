# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://myblog:myblog@localhost:5432/myblog?schema=public"

# Public site origin for canonical URLs and deployment checks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Single-admin MVP credentials. Store a hash in production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="replace-with-argon2-hash"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Salt used before hashing IP addresses for view events.
IP_HASH_SECRET="replace-with-a-long-random-secret"
