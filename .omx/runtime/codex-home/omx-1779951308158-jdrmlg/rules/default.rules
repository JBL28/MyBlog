prefix_rule(pattern=["printf", "%s\\n", "--- Dockerfile ---"], decision="allow")
prefix_rule(pattern=["grep", "-R", "DATABASE_URL\\|POSTGRES\\|MYSQL\\|sqlite\\|db", "-n", "--exclude-dir=node_modules", "--exclude-dir=.git", "."], decision="allow")
prefix_rule(pattern=["cat", "package.json"], decision="allow")
prefix_rule(pattern=["find", "prisma", "-maxdepth", "3", "-type", "f", "-print"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["docker", "compose"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "ENV_FILE=.env.server.example docker compose --env-file .env.server.example config"], decision="allow")
prefix_rule(pattern=["git", "diff", "--", ".gitignore", "Dockerfile"], decision="allow")
prefix_rule(pattern=["npm", "run", "lint"], decision="allow")
prefix_rule(pattern=["npm", "run", "typecheck"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "DATABASE_URL='postgresql://build:build@localhost:5432/build?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' ADMIN_USERNAME='admin' ADMIN_PASSWORD_HASH='test' ADMIN_SESSION_SECRET='test-secret' IP_HASH_SECRET='test-secret' npm run build"], decision="allow")
prefix_rule(pattern=["npm", "run", "test:ci"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow")
prefix_rule(pattern=["git", "diff", "--", ".env.example", ".github/workflows/main.yml", "Dockerfile", "docker-compose.yml", ".env.server.example", "README.md", "src/app/page.tsx", "src/lib/db-health.ts"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")
prefix_rule(pattern=["git", "log", "-1", "--oneline"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["command", "-v", "gh"], decision="allow")
prefix_rule(pattern=["git", "diff", "--", "src/lib/db-health.ts"], decision="allow")
prefix_rule(pattern=["git", "log", "-5", "--oneline", "--decorate"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "branch", "-vv"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["grep", "-R", "NEXT_PUBLIC_SITE_URL", "-n", "--exclude-dir=node_modules", "--exclude-dir=.git", "--exclude-dir=.next", "--exclude-dir=.omx", "--exclude-dir=.codex", "."], decision="allow")
prefix_rule(pattern=["printf", "\\n--- db-health ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- workflow build url sections ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- workflow excerpts ---\\n"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "DATABASE_URL='postgresql://myblog:myblog@myblog-db:5432/myblog?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' PORT=3010 npm run start"], decision="allow")
prefix_rule(pattern=["pgrep", "-af", "next start|server.js"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "DATABASE_URL='postgresql://myblog:myblog@myblog-db:5432/myblog?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' PORT=3011 HOSTNAME='0.0.0.0' node .next/standalone/server.js"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "curl -sS http://localhost:3011/ >/tmp/myblog-smoke.html && wc -c /tmp/myblog-smoke.html"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "DATABASE_URL='postgresql://myblog:myblog@myblog-db:5432/myblog?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' npm run build"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "DATABASE_URL='postgresql://myblog:myblog@myblog-db:5432/myblog?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' PORT=3012 HOSTNAME='0.0.0.0' node .next/standalone/docker-entrypoint.mjs"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "cp docker-entrypoint.mjs .next/standalone/docker-entrypoint.mjs && DATABASE_URL='postgresql://myblog:myblog@myblog-db:5432/myblog?schema=public' NEXT_PUBLIC_SITE_URL='http://localhost:3000' PORT=3012 HOSTNAME='0.0.0.0' node .next/standalone/docker-entrypoint.mjs"], decision="allow")
prefix_rule(pattern=["pgrep", "-af", "node .next/standalone/docker-entrypoint.mjs"], decision="allow")
prefix_rule(pattern=["git", "add", ".github/workflows/main.yml", "Dockerfile", "README.md", "src/app/page.tsx", "src/lib/db-health.ts", "src/instrumentation.ts", "docker-entrypoint.mjs"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- docs ---\\n"], decision="allow")
prefix_rule(pattern=["git", "log", "--oneline", "--decorate", "-8"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- requirements ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- prisma ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- hydrator ---\\n"], decision="allow")
