prefix_rule(pattern=["printf", "\\n--- globals ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- section ---\\n"], decision="allow")
prefix_rule(pattern=["printf", "\\n--- next config ---\\n"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")
